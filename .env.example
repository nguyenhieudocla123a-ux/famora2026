# Copy this file to .env (same folder) and fill in your own values. .env is never committed.

# PostgreSQL (used by docker-compose.yml and by the backend)
POSTGRES_DB=famora
POSTGRES_USER=famora
POSTGRES_PASSWORD=doi_mat_khau_nay
POSTGRES_PORT=5434
DB_URL=jdbc:postgresql://localhost:5434/famora

# JWT signing key: base64 of 32+ random bytes. Generate one in PowerShell:
#   [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Maximum 256 }))
JWT_SECRET=
